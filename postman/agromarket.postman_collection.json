    {
      "name": "ЛР6 — CRUD только на тестовой БД",
      "item": [
        {
          "name": "01 — Health и подготовка запуска",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('testName', 'lab6-postman-' + runId);",
                  "pm.collectionVariables.set('testEmail', 'lab6-' + runId + '@example.invalid');",
                  "pm.collectionVariables.unset('productId'); pm.collectionVariables.unset('orderId');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON-ответ\", () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); pm.expect(pm.response.json()).to.not.equal(null); });",
                  "pm.test(\"API и БД доступны\", () => { const b=pm.response.json(); pm.expect(b.status).to.eql('ok'); pm.expect(b.db).to.eql('connected'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          }
        },
        {
          "name": "02 — Список товаров",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON-ответ\", () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); pm.expect(pm.response.json()).to.not.equal(null); });",
                  "pm.test(\"Массив товаров\", () => { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "03 — Поиск товаров",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON-ответ\", () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); pm.expect(pm.response.json()).to.not.equal(null); });",
                  "pm.test(\"Поиск молока\", () => { const b=pm.response.json(); pm.expect(b).to.be.an('array').and.not.empty; b.forEach(p=>pm.expect(p.name.toLowerCase()).to.include('мол')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?search=%D0%BC%D0%BE%D0%BB"
          }
        },
        {
          "name": "04 — Создать тестовый товар",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('allowWrites') !== 'true') {",
                  "  pm.execution.skipRequest();",
                  "} else {",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => { pm.response.to.have.status(201); });",
                  "pm.test(\"JSON-ответ\", () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); pm.expect(pm.response.json()).to.not.equal(null); });",
                  "pm.test(\"Созданный товар\", () => { const b=pm.response.json(); pm.expect(b.id).to.be.a('number').above(0); pm.expect(b.name).to.eql(pm.collectionVariables.get('testName')); pm.expect(b.price).to.eql(100); });",
                  "const b=pm.response.json(); if(pm.response.code===201 && Number.isInteger(b.id) && b.id>0 && b.name===pm.collectionVariables.get('testName')) pm.collectionVariables.set('productId', b.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminJwt}}"
              }
            ],
            "url": "{{baseUrl}}/api/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{testName}}\",\n  \"price\": 100,\n  \"category\": \"lab6-test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "05 — Получить созданный товар",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('allowWrites') !== 'true') {",
                  "  pm.execution.skipRequest();",
                  "} else {",
                  "const id = pm.collectionVariables.get('productId'); if (!/^[1-9]\\d*$/.test(String(id)) || Number(id) < 1) { pm.execution.skipRequest(); throw new Error('Нет ID тестовой записи текущего запуска'); } pm.variables.set('productId', id);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
